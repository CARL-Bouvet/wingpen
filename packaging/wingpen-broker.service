[Unit]
Description=Wingpen broker — passerelle locale extension/modèle IA
Documentation=https://github.com/romain/wingpen
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/romain/projets/wingpen/broker
ExecStart=/home/romain/.bun/bin/bun run src/server.ts
# `on-failure` was measured insufficient on 2026-09-21: a plain `pkill` makes
# the broker exit 0, systemd reads that as "job done", and the broker stays
# dead until a human notices — the extension then fails with a banner that
# says nothing about the real cause. `always` restarts it whatever the exit
# code, which is what a background daemon the user never thinks about needs.
Restart=always
RestartSec=2s

# A systemd user service inherits a minimal PATH — /usr/local/bin:/usr/bin and
# little else — so `command -v claude` finds nothing, the provider silently
# falls back to the SDK's bundled CLI copy, and that copy is broken (EEXIST on
# /todos, see MEMORY.md). Measured 2026-09-20: the request then hangs with no
# answer and no error. Naming the binary outright removes the guesswork; the
# provider honours this override before it ever looks at PATH
# (broker/src/providers/claude-cli.ts:44).
Environment=WINGPEN_CLAUDE_PATH=/home/romain/.local/bin/claude

# Journal systemd (stdout + stderr)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wingpen-broker

# Hardening — loopback-only local server, no privileges needed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Config and data dirs the broker reads/writes at runtime
ReadWritePaths=%h/.config/wingpen %h/.local/share/wingpen

[Install]
WantedBy=default.target
